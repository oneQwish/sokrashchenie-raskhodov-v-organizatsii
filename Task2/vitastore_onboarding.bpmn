<bpmn:messageEventDefinition id="MED_cl_start" />
</bpmn:startEvent>
<bpmn:task id="cl_profile" name="Подготовить профиль магазина: матрица, цены, устройства">
<bpmn:incoming>F_cl_start_cl_profile</bpmn:incoming>
<bpmn:outgoing>F_cl_profile_cl_split1</bpmn:outgoing>
</bpmn:task>
<bpmn:parallelGateway id="cl_split1" name="">
<bpmn:incoming>F_cl_profile_cl_split1</bpmn:incoming>
<bpmn:outgoing>F_cl_split1_cl_dev_wait</bpmn:outgoing>
<bpmn:outgoing>F_cl_split1_cl_split2</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:parallelGateway id="cl_split2" name="">
<bpmn:incoming>F_cl_split1_cl_split2</bpmn:incoming>
<bpmn:outgoing>F_cl_split2_cl_inv_wait</bpmn:outgoing>
<bpmn:outgoing>F_cl_split2_cl_dump_wait</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:intermediateCatchEvent id="cl_dump_wait" name="Выгрузка старой базы получена">
<bpmn:incoming>F_cl_split2_cl_dump_wait</bpmn:incoming>
<bpmn:outgoing>F_cl_dump_wait_cl_match</bpmn:outgoing>
<bpmn:dataOutputAssociation id="DOA_dump"><bpmn:targetRef>DO_dump</bpmn:targetRef></bpmn:dataOutputAssociation>
<bpmn:messageEventDefinition id="MED_cl_dump_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:task id="cl_match" name="Сверить штрихкод каждой позиции с эталонным каталогом">
<bpmn:incoming>F_cl_dump_wait_cl_match</bpmn:incoming>
<bpmn:outgoing>F_cl_match_cl_gw1</bpmn:outgoing>
<bpmn:property id="Prop_cl_match" name="__targetRef_placeholder" />
<bpmn:dataInputAssociation id="DIA_dump"><bpmn:sourceRef>DO_dump</bpmn:sourceRef><bpmn:targetRef>Prop_cl_match</bpmn:targetRef></bpmn:dataInputAssociation>
<bpmn:dataInputAssociation id="DIA_cat"><bpmn:sourceRef>DS_cat</bpmn:sourceRef><bpmn:targetRef>Prop_cl_match</bpmn:targetRef></bpmn:dataInputAssociation>
<bpmn:multiInstanceLoopCharacteristics />
</bpmn:task>
<bpmn:exclusiveGateway id="cl_gw1" name="Все позиции найдены по штрихкоду?">
<bpmn:incoming>F_cl_match_cl_gw1</bpmn:incoming>
<bpmn:outgoing>F_cl_gw1_cl_m1</bpmn:outgoing>
<bpmn:outgoing>F_cl_gw1_cl_ai_send</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="cl_ai_send" name="Передать ненайденные позиции в AI-сервис">
<bpmn:incoming>F_cl_gw1_cl_ai_send</bpmn:incoming>
<bpmn:outgoing>F_cl_ai_send_cl_ai_wait</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="cl_ai_wait" name="Кандидаты SKU и уверенность получены">
<bpmn:incoming>F_cl_ai_send_cl_ai_wait</bpmn:incoming>
<bpmn:outgoing>F_cl_ai_wait_cl_m1</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_cl_ai_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="cl_m1" name="">
<bpmn:incoming>F_cl_gw1_cl_m1</bpmn:incoming>
<bpmn:incoming>F_cl_ai_wait_cl_m1</bpmn:incoming>
<bpmn:outgoing>F_cl_m1_cl_join1</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="cl_inv_wait" name="Скан-лист инвентаризации получен">
<bpmn:incoming>F_cl_split2_cl_inv_wait</bpmn:incoming>
<bpmn:outgoing>F_cl_inv_wait_cl_join1</bpmn:outgoing>
<bpmn:dataOutputAssociation id="DOA_scan"><bpmn:targetRef>DO_scan</bpmn:targetRef></bpmn:dataOutputAssociation>
<bpmn:messageEventDefinition id="MED_cl_inv_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:parallelGateway id="cl_join1" name="">
<bpmn:incoming>F_cl_m1_cl_join1</bpmn:incoming>
<bpmn:incoming>F_cl_inv_wait_cl_join1</bpmn:incoming>
<bpmn:outgoing>F_cl_join1_cl_route</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:task id="cl_route" name="Свести остатки по SKU и отобрать позиции на проверку">
<bpmn:incoming>F_cl_join1_cl_route</bpmn:incoming>
<bpmn:outgoing>F_cl_route_cl_hq_send</bpmn:outgoing>
<bpmn:property id="Prop_cl_route" name="__targetRef_placeholder" />
<bpmn:dataInputAssociation id="DIA_scan"><bpmn:sourceRef>DO_scan</bpmn:sourceRef><bpmn:targetRef>Prop_cl_route</bpmn:targetRef></bpmn:dataInputAssociation>
</bpmn:task>
<bpmn:sendTask id="cl_hq_send" name="Передать позиции товароведу">
<bpmn:incoming>F_cl_route_cl_hq_send</bpmn:incoming>
<bpmn:outgoing>F_cl_hq_send_cl_hq_wait</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="cl_hq_wait" name="Позиции разобраны">
<bpmn:incoming>F_cl_hq_send_cl_hq_wait</bpmn:incoming>
<bpmn:outgoing>F_cl_hq_wait_cl_learn</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_cl_hq_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:task id="cl_learn" name="Сохранить подтверждённые сопоставления в справочник">
<bpmn:incoming>F_cl_hq_wait_cl_learn</bpmn:incoming>
<bpmn:outgoing>F_cl_learn_cl_sap_send</bpmn:outgoing>
<bpmn:dataOutputAssociation id="DOA_map"><bpmn:targetRef>DS_map</bpmn:targetRef></bpmn:dataOutputAssociation>
</bpmn:task>
<bpmn:sendTask id="cl_sap_send" name="Передать ассортиментную матрицу и остатки в SAP ERP">
<bpmn:incoming>F_cl_learn_cl_sap_send</bpmn:incoming>
<bpmn:outgoing>F_cl_sap_send_cl_sap_wait</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="cl_sap_wait" name="Данные магазина загружены">
<bpmn:incoming>F_cl_sap_send_cl_sap_wait</bpmn:incoming>
<bpmn:outgoing>F_cl_sap_wait_cl_join_f</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_cl_sap_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:parallelGateway id="cl_join_f" name="">
<bpmn:incoming>F_cl_dev_send_cl_join_f</bpmn:incoming>
<bpmn:incoming>F_cl_sap_wait_cl_join_f</bpmn:incoming>
<bpmn:outgoing>F_cl_join_f_cl_publish</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:task id="cl_publish" name="Опубликовать каталог, цены и остатки на смарт-терминалы">
<bpmn:incoming>F_cl_join_f_cl_publish</bpmn:incoming>
<bpmn:outgoing>F_cl_publish_cl_end</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="cl_end" name="Магазин готов к пробным продажам">
<bpmn:incoming>F_cl_publish_cl_end</bpmn:incoming>
<bpmn:messageEventDefinition id="MED_cl_end" />
</bpmn:endEvent>
<bpmn:dataObject id="DO_dump_obj" />
<bpmn:dataObjectReference id="DO_dump" name="Выгрузка старой базы (штрихкод, название)" dataObjectRef="DO_dump_obj" />
<bpmn:dataStoreReference id="DS_cat" name="Эталонный каталог" dataStoreRef="Store_cat" />
<bpmn:dataObject id="DO_scan_obj" />
<bpmn:dataObjectReference id="DO_scan" name="Скан-лист (штрихкод + количество)" dataObjectRef="DO_scan_obj" />
<bpmn:dataStoreReference id="DS_map" name="Справочник сопоставлений" dataStoreRef="Store_map" />
<bpmn:sequenceFlow id="F_cl_dev_wait_cl_dev_act" sourceRef="cl_dev_wait" targetRef="cl_dev_act" />
<bpmn:sequenceFlow id="F_cl_dev_act_cl_dev_send" sourceRef="cl_dev_act" targetRef="cl_dev_send" />
<bpmn:sequenceFlow id="F_cl_dev_send_cl_join_f" sourceRef="cl_dev_send" targetRef="cl_join_f" />
<bpmn:sequenceFlow id="F_cl_start_cl_profile" sourceRef="cl_start" targetRef="cl_profile" />
<bpmn:sequenceFlow id="F_cl_profile_cl_split1" sourceRef="cl_profile" targetRef="cl_split1" />
<bpmn:sequenceFlow id="F_cl_split1_cl_dev_wait" sourceRef="cl_split1" targetRef="cl_dev_wait" />
<bpmn:sequenceFlow id="F_cl_split1_cl_split2" sourceRef="cl_split1" targetRef="cl_split2" />
<bpmn:sequenceFlow id="F_cl_split2_cl_inv_wait" sourceRef="cl_split2" targetRef="cl_inv_wait" />
<bpmn:sequenceFlow id="F_cl_split2_cl_dump_wait" sourceRef="cl_split2" targetRef="cl_dump_wait" />
<bpmn:sequenceFlow id="F_cl_dump_wait_cl_match" sourceRef="cl_dump_wait" targetRef="cl_match" />
<bpmn:sequenceFlow id="F_cl_match_cl_gw1" sourceRef="cl_match" targetRef="cl_gw1" />
<bpmn:sequenceFlow id="F_cl_gw1_cl_m1" name="Да" sourceRef="cl_gw1" targetRef="cl_m1" />
<bpmn:sequenceFlow id="F_cl_gw1_cl_ai_send" name="Нет" sourceRef="cl_gw1" targetRef="cl_ai_send" />
<bpmn:sequenceFlow id="F_cl_ai_send_cl_ai_wait" sourceRef="cl_ai_send" targetRef="cl_ai_wait" />
<bpmn:sequenceFlow id="F_cl_ai_wait_cl_m1" sourceRef="cl_ai_wait" targetRef="cl_m1" />
<bpmn:sequenceFlow id="F_cl_m1_cl_join1" sourceRef="cl_m1" targetRef="cl_join1" />
<bpmn:sequenceFlow id="F_cl_inv_wait_cl_join1" sourceRef="cl_inv_wait" targetRef="cl_join1" />
<bpmn:sequenceFlow id="F_cl_join1_cl_route" sourceRef="cl_join1" targetRef="cl_route" />
<bpmn:sequenceFlow id="F_cl_route_cl_hq_send" sourceRef="cl_route" targetRef="cl_hq_send" />
<bpmn:sequenceFlow id="F_cl_hq_send_cl_hq_wait" sourceRef="cl_hq_send" targetRef="cl_hq_wait" />
<bpmn:sequenceFlow id="F_cl_hq_wait_cl_learn" sourceRef="cl_hq_wait" targetRef="cl_learn" />
<bpmn:sequenceFlow id="F_cl_learn_cl_sap_send" sourceRef="cl_learn" targetRef="cl_sap_send" />
<bpmn:sequenceFlow id="F_cl_sap_send_cl_sap_wait" sourceRef="cl_sap_send" targetRef="cl_sap_wait" />
<bpmn:sequenceFlow id="F_cl_sap_wait_cl_join_f" sourceRef="cl_sap_wait" targetRef="cl_join_f" />
<bpmn:sequenceFlow id="F_cl_join_f_cl_publish" sourceRef="cl_join_f" targetRef="cl_publish" />
<bpmn:sequenceFlow id="F_cl_publish_cl_end" sourceRef="cl_publish" targetRef="cl_end" />
<bpmn:textAnnotation id="A_match"><bpmn:text>Шаг 1: штрихкод найден в эталонном каталоге — позиция сопоставляется сразу. Шаг 2: не найден — AI-сервис предлагает SKU по названию с оценкой уверенности. 95% и выше — принимается автоматически, ниже 95% — товароведу. Товаровед также проверяет случайные 5% автоматически принятых позиций.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A_match" sourceRef="cl_route" targetRef="A_match" />
<bpmn:textAnnotation id="A_learn"><bpmn:text>Каждое решение товароведа сохраняется. Следующий магазин той же купленной сети сопоставляется точнее, и на проверку уходит меньше позиций.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A_learn" sourceRef="cl_learn" targetRef="A_learn" />
</bpmn:process>
<bpmn:process id="Proc_AI" isExecutable="false">
<bpmn:startEvent id="ai_start" name="Ненайденные позиции получены">
<bpmn:outgoing>F_ai_start_ai_task</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_ai_start" />
</bpmn:startEvent>
<bpmn:task id="ai_task" name="Подобрать SKU для каждой позиции и оценить уверенность">
<bpmn:incoming>F_ai_start_ai_task</bpmn:incoming>
<bpmn:outgoing>F_ai_task_ai_end</bpmn:outgoing>
<bpmn:property id="Prop_ai_task" name="__targetRef_placeholder" />
<bpmn:dataInputAssociation id="DIA_cat_ai"><bpmn:sourceRef>DS_cat_ai</bpmn:sourceRef><bpmn:targetRef>Prop_ai_task</bpmn:targetRef></bpmn:dataInputAssociation>
<bpmn:dataInputAssociation id="DIA_map_ai"><bpmn:sourceRef>DS_map_ai</bpmn:sourceRef><bpmn:targetRef>Prop_ai_task</bpmn:targetRef></bpmn:dataInputAssociation>
<bpmn:multiInstanceLoopCharacteristics />
</bpmn:task>
<bpmn:endEvent id="ai_end" name="Кандидаты отправлены">
<bpmn:incoming>F_ai_task_ai_end</bpmn:incoming>
<bpmn:messageEventDefinition id="MED_ai_end" />
</bpmn:endEvent>
<bpmn:dataStoreReference id="DS_cat_ai" name="Эталонный каталог" dataStoreRef="Store_cat" />
<bpmn:dataStoreReference id="DS_map_ai" name="Справочник сопоставлений" dataStoreRef="Store_map" />
<bpmn:sequenceFlow id="F_ai_start_ai_task" sourceRef="ai_start" targetRef="ai_task" />
<bpmn:sequenceFlow id="F_ai_task_ai_end" sourceRef="ai_task" targetRef="ai_end" />
<bpmn:textAnnotation id="A_ai"><bpmn:text>Для каждой позиции без совпадения по штрихкоду сервис предлагает SKU из эталонного каталога и оценку уверенности. Использует название из старой базы и уже подтверждённые товароведом сопоставления. Решение по цене и новым SKU принимает человек.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A_ai" sourceRef="ai_task" targetRef="A_ai" />
</bpmn:process>
<bpmn:process id="Proc_SAP" isExecutable="false">
<bpmn:startEvent id="sap_start" name="Данные магазина получены">
<bpmn:outgoing>F_sap_start_sap_load</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_sap_start" />
</bpmn:startEvent>
<bpmn:task id="sap_load" name="Загрузить ассортиментную матрицу и начальные остатки магазина">
<bpmn:incoming>F_sap_start_sap_load</bpmn:incoming>
<bpmn:outgoing>F_sap_load_sap_end</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="sap_end" name="Данные загружены">
<bpmn:incoming>F_sap_load_sap_end</bpmn:incoming>
<bpmn:messageEventDefinition id="MED_sap_end" />
</bpmn:endEvent>
<bpmn:sequenceFlow id="F_sap_start_sap_load" sourceRef="sap_start" targetRef="sap_load" />
<bpmn:sequenceFlow id="F_sap_load_sap_end" sourceRef="sap_load" targetRef="sap_end" />
</bpmn:process>
