<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_VitaStore" targetNamespace="http://vitastore.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
<bpmn:collaboration id="Collab_Onboarding">
<bpmn:participant id="P_HQ" name="HQ VitaStore" processRef="Proc_HQ" />
<bpmn:participant id="P_LOG" name="Логистика (SaaS, курьерская служба)" processRef="Proc_LOG" />
<bpmn:participant id="P_ST" name="Магазин (новая точка)" processRef="Proc_ST" />
<bpmn:participant id="P_BANK" name="Банк-эквайер" />
<bpmn:participant id="P_CL" name="Облачная платформа VitaStore" processRef="Proc_CL" />
<bpmn:participant id="P_AI" name="AI-сервис сопоставления номенклатуры" processRef="Proc_AI" />
<bpmn:participant id="P_SAP" name="SAP ERP" processRef="Proc_SAP" />
<bpmn:messageFlow id="MF_reg_cl" name="Карточка магазина" sourceRef="ma_register" targetRef="cl_start" />
<bpmn:messageFlow id="MF_reg_lg" name="Заявка на комплект" sourceRef="ma_register" targetRef="lg_start" />
<bpmn:messageFlow id="MF_reg_st" name="Инструкция по выгрузке" sourceRef="ma_register" targetRef="st_start" />
<bpmn:messageFlow id="MF_lg_st" name="Комплект доставлен" sourceRef="lg_end" targetRef="st_kit" />
<bpmn:messageFlow id="MF_dump" name="Выгрузка старой базы" sourceRef="st_dump" targetRef="cl_dump_wait" />
<bpmn:messageFlow id="MF_scan" name="Скан-лист инвентаризации" sourceRef="st_send" targetRef="cl_inv_wait" />
<bpmn:messageFlow id="MF_act" name="Запрос активации (модели терминалов)" sourceRef="tm_req" targetRef="cl_dev_wait" />
<bpmn:messageFlow id="MF_cfg" name="Конфигурация и драйверы HAL" sourceRef="cl_dev_send" targetRef="tm_wait" />
<bpmn:messageFlow id="MF_bank1" name="Тестовая авторизация" sourceRef="tm_test" targetRef="P_BANK" />
<bpmn:messageFlow id="MF_bank2" name="Ответ банка" sourceRef="P_BANK" targetRef="tm_test" />
<bpmn:messageFlow id="MF_ai1" name="Ненайденные позиции" sourceRef="cl_ai_send" targetRef="ai_start" />
<bpmn:messageFlow id="MF_ai2" name="Кандидаты SKU + уверенность" sourceRef="ai_end" targetRef="cl_ai_wait" />
<bpmn:messageFlow id="MF_hq1" name="Позиции на проверку" sourceRef="cl_hq_send" targetRef="hq_start" />
<bpmn:messageFlow id="MF_hq2" name="Позиции разобраны" sourceRef="hq_end" targetRef="cl_hq_wait" />
<bpmn:messageFlow id="MF_sap1" name="Ассортиментная матрица и остатки" sourceRef="cl_sap_send" targetRef="sap_start" />
<bpmn:messageFlow id="MF_sap2" name="Данные загружены" sourceRef="sap_end" targetRef="cl_sap_wait" />
<bpmn:messageFlow id="MF_ready" name="Каталог опубликован, устройства активны" sourceRef="cl_end" targetRef="st_wait" />
<bpmn:messageFlow id="MF_open" name="Магазин открыт" sourceRef="st_end" targetRef="ma_wait" />
</bpmn:collaboration>
<bpmn:dataStore id="Store_cat" name="Эталонный каталог" />
<bpmn:dataStore id="Store_map" name="Справочник сопоставлений" />
<bpmn:process id="Proc_HQ" isExecutable="false">
<bpmn:laneSet id="LS_Proc_HQ">
<bpmn:lane id="L_MA" name="Департамент M&amp;A">
<bpmn:flowNodeRef>ma_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ma_register</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ma_wait</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ma_kpi</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ma_end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_TOV" name="Товаровед (коммерческий департамент)">
<bpmn:flowNodeRef>hq_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>hq_sub</bpmn:flowNodeRef>
<bpmn:flowNodeRef>hq_check</bpmn:flowNodeRef>
<bpmn:flowNodeRef>hq_end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ma_start" name="Сделка по магазину закрыта">
<bpmn:outgoing>F_ma_start_ma_register</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:task id="ma_register" name="Зарегистрировать магазин и запустить онбординг">
<bpmn:incoming>F_ma_start_ma_register</bpmn:incoming>
<bpmn:outgoing>F_ma_register_ma_wait</bpmn:outgoing>
</bpmn:task>
<bpmn:intermediateCatchEvent id="ma_wait" name="Магазин открыт">
<bpmn:incoming>F_ma_register_ma_wait</bpmn:incoming>
<bpmn:outgoing>F_ma_wait_ma_kpi</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_ma_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:task id="ma_kpi" name="Зафиксировать срок онбординга (KPI: не более 5 дней)">
<bpmn:incoming>F_ma_wait_ma_kpi</bpmn:incoming>
<bpmn:outgoing>F_ma_kpi_ma_end</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="ma_end" name="Онбординг завершён">
<bpmn:incoming>F_ma_kpi_ma_end</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="hq_start" name="Получены позиции на проверку">
<bpmn:outgoing>F_hq_start_hq_sub</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_hq_start" />
</bpmn:startEvent>
<bpmn:subProcess id="hq_sub" name="Проверить каждую позицию">
<bpmn:incoming>F_hq_start_hq_sub</bpmn:incoming>
<bpmn:outgoing>F_hq_sub_hq_check</bpmn:outgoing>
<bpmn:multiInstanceLoopCharacteristics />
<bpmn:startEvent id="sp_start" name="Позиция из списка">
<bpmn:outgoing>F_sp_start_sp_gw</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:exclusiveGateway id="sp_gw" name="Решение по позиции">
<bpmn:incoming>F_sp_start_sp_gw</bpmn:incoming>
<bpmn:outgoing>F_sp_gw_sp_ok</bpmn:outgoing>
<bpmn:outgoing>F_sp_gw_sp_link</bpmn:outgoing>
<bpmn:outgoing>F_sp_gw_sp_new</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="sp_ok" name="Подтвердить кандидата AI">
<bpmn:incoming>F_sp_gw_sp_ok</bpmn:incoming>
<bpmn:outgoing>F_sp_ok_sp_merge</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="sp_link" name="Выбрать другой SKU из каталога (фасовка, внутренний код)">
<bpmn:incoming>F_sp_gw_sp_link</bpmn:incoming>
<bpmn:outgoing>F_sp_link_sp_merge</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="sp_new" name="Завести новый SKU (категория, цена, поставщик)">
<bpmn:incoming>F_sp_gw_sp_new</bpmn:incoming>
<bpmn:outgoing>F_sp_new_sp_merge</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="sp_merge" name="">
<bpmn:incoming>F_sp_ok_sp_merge</bpmn:incoming>
<bpmn:incoming>F_sp_link_sp_merge</bpmn:incoming>
<bpmn:incoming>F_sp_new_sp_merge</bpmn:incoming>
<bpmn:outgoing>F_sp_merge_sp_end</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="sp_end" name="Позиция проверена">
<bpmn:incoming>F_sp_merge_sp_end</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="F_sp_start_sp_gw" sourceRef="sp_start" targetRef="sp_gw" />
<bpmn:sequenceFlow id="F_sp_gw_sp_ok" name="Кандидат верный" sourceRef="sp_gw" targetRef="sp_ok" />
<bpmn:sequenceFlow id="F_sp_gw_sp_link" name="Другой SKU" sourceRef="sp_gw" targetRef="sp_link" />
<bpmn:sequenceFlow id="F_sp_gw_sp_new" name="Товара нет в каталоге" sourceRef="sp_gw" targetRef="sp_new" />
<bpmn:sequenceFlow id="F_sp_ok_sp_merge" sourceRef="sp_ok" targetRef="sp_merge" />
<bpmn:sequenceFlow id="F_sp_link_sp_merge" sourceRef="sp_link" targetRef="sp_merge" />
<bpmn:sequenceFlow id="F_sp_new_sp_merge" sourceRef="sp_new" targetRef="sp_merge" />
<bpmn:sequenceFlow id="F_sp_merge_sp_end" sourceRef="sp_merge" targetRef="sp_end" />
</bpmn:subProcess>
<bpmn:task id="hq_check" name="Проверить цены новых SKU (второй сотрудник)">
<bpmn:incoming>F_hq_sub_hq_check</bpmn:incoming>
<bpmn:outgoing>F_hq_check_hq_end</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="hq_end" name="Позиции разобраны">
<bpmn:incoming>F_hq_check_hq_end</bpmn:incoming>
<bpmn:messageEventDefinition id="MED_hq_end" />
</bpmn:endEvent>
<bpmn:sequenceFlow id="F_ma_start_ma_register" sourceRef="ma_start" targetRef="ma_register" />
<bpmn:sequenceFlow id="F_ma_register_ma_wait" sourceRef="ma_register" targetRef="ma_wait" />
<bpmn:sequenceFlow id="F_ma_wait_ma_kpi" sourceRef="ma_wait" targetRef="ma_kpi" />
<bpmn:sequenceFlow id="F_ma_kpi_ma_end" sourceRef="ma_kpi" targetRef="ma_end" />
<bpmn:sequenceFlow id="F_hq_start_hq_sub" sourceRef="hq_start" targetRef="hq_sub" />
<bpmn:sequenceFlow id="F_hq_sub_hq_check" sourceRef="hq_sub" targetRef="hq_check" />
<bpmn:sequenceFlow id="F_hq_check_hq_end" sourceRef="hq_check" targetRef="hq_end" />
<bpmn:textAnnotation id="A_time"><bpmn:text>План на 5 дней. День 1: выгрузка старой базы, автоматическая сверка по штрихкоду и AI; доставка комплекта. День 2: подготовка склада, подключение и активация касс. День 3: инвентаризация на ТСД. Дни 3–4: товаровед проверяет позиции с уверенностью ниже 95% и выборку. Дни 4–5: загрузка в SAP, публикация на кассы, пробные продажи, открытие.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
<bpmn:process id="Proc_LOG" isExecutable="false">
<bpmn:startEvent id="lg_start" name="Заявка на комплект">
<bpmn:outgoing>F_lg_start_lg_task</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_lg_start" />
</bpmn:startEvent>
<bpmn:task id="lg_task" name="Доставить смарт-терминалы, роутер и комплект ТСД">
<bpmn:incoming>F_lg_start_lg_task</bpmn:incoming>
<bpmn:outgoing>F_lg_task_lg_end</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="lg_end" name="Комплект доставлен">
<bpmn:incoming>F_lg_task_lg_end</bpmn:incoming>
<bpmn:messageEventDefinition id="MED_lg_end" />
</bpmn:endEvent>
<bpmn:sequenceFlow id="F_lg_start_lg_task" sourceRef="lg_start" targetRef="lg_task" />
<bpmn:sequenceFlow id="F_lg_task_lg_end" sourceRef="lg_task" targetRef="lg_end" />
<bpmn:textAnnotation id="A_tsd"><bpmn:text>Комплект ТСД многоразовый: после инвентаризации курьер забирает его и везёт в следующий магазин.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
<bpmn:process id="Proc_ST" isExecutable="false">
<bpmn:laneSet id="LS_Proc_ST">
<bpmn:lane id="L_STAFF" name="Сотрудники магазина">
<bpmn:flowNodeRef>st_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_dump</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_kit</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_split</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_prep</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_scan</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_send</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_connect</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_join</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_wait</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_merge</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_pilot</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_fix</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_open</bpmn:flowNodeRef>
<bpmn:flowNodeRef>st_end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_TERM" name="Смарт-терминал (Cloud POS + Edge HAL)">
<bpmn:flowNodeRef>tm_req</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tm_wait</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tm_test</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="st_start" name="Инструкция по онбордингу получена">
<bpmn:outgoing>F_st_start_st_dump</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_st_start" />
</bpmn:startEvent>
<bpmn:sendTask id="st_dump" name="Выгрузить базу товаров из старой кассы и отправить в сервис онбординга">
<bpmn:incoming>F_st_start_st_dump</bpmn:incoming>
<bpmn:outgoing>F_st_dump_st_kit</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="st_kit" name="Комплект получен">
<bpmn:incoming>F_st_dump_st_kit</bpmn:incoming>
<bpmn:outgoing>F_st_kit_st_split</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_st_kit" />
</bpmn:intermediateCatchEvent>
<bpmn:parallelGateway id="st_split" name="">
<bpmn:incoming>F_st_kit_st_split</bpmn:incoming>
<bpmn:outgoing>F_st_split_st_prep</bpmn:outgoing>
<bpmn:outgoing>F_st_split_st_connect</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:task id="st_prep" name="Подготовить склад к инвентаризации">
<bpmn:incoming>F_st_split_st_prep</bpmn:incoming>
<bpmn:outgoing>F_st_prep_st_scan</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="st_scan" name="Провести инвентаризацию на ТСД">
<bpmn:incoming>F_st_prep_st_scan</bpmn:incoming>
<bpmn:outgoing>F_st_scan_st_send</bpmn:outgoing>
</bpmn:task>
<bpmn:intermediateThrowEvent id="st_send" name="Скан-лист отправлен">
<bpmn:incoming>F_st_scan_st_send</bpmn:incoming>
<bpmn:outgoing>F_st_send_st_join</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_st_send" />
</bpmn:intermediateThrowEvent>
<bpmn:task id="st_connect" name="Подключить смарт-терминалы и банковские терминалы">
<bpmn:incoming>F_st_split_st_connect</bpmn:incoming>
<bpmn:outgoing>F_st_connect_tm_req</bpmn:outgoing>
</bpmn:task>
<bpmn:parallelGateway id="st_join" name="">
<bpmn:incoming>F_st_send_st_join</bpmn:incoming>
<bpmn:incoming>F_tm_test_st_join</bpmn:incoming>
<bpmn:outgoing>F_st_join_st_wait</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:intermediateCatchEvent id="st_wait" name="Магазин готов к пробным продажам">
<bpmn:incoming>F_st_join_st_wait</bpmn:incoming>
<bpmn:outgoing>F_st_wait_st_merge</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_st_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="st_merge" name="">
<bpmn:incoming>F_st_wait_st_merge</bpmn:incoming>
<bpmn:incoming>F_st_fix_st_merge</bpmn:incoming>
<bpmn:outgoing>F_st_merge_st_pilot</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="st_pilot" name="Пробные продажи и выборочная сверка цен и ценников">
<bpmn:incoming>F_st_merge_st_pilot</bpmn:incoming>
<bpmn:outgoing>F_st_pilot_st_gw</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="st_gw" name="Расхождения есть?">
<bpmn:incoming>F_st_pilot_st_gw</bpmn:incoming>
<bpmn:outgoing>F_st_gw_st_open</bpmn:outgoing>
<bpmn:outgoing>F_st_gw_st_fix</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="st_fix" name="Исправить расхождения вместе с товароведом">
<bpmn:incoming>F_st_gw_st_fix</bpmn:incoming>
<bpmn:outgoing>F_st_fix_st_merge</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="st_open" name="Открыть магазин под брендом VitaStore">
<bpmn:incoming>F_st_gw_st_open</bpmn:incoming>
<bpmn:outgoing>F_st_open_st_end</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="st_end" name="Магазин открыт">
<bpmn:incoming>F_st_open_st_end</bpmn:incoming>
<bpmn:messageEventDefinition id="MED_st_end" />
</bpmn:endEvent>
<bpmn:sendTask id="tm_req" name="Определить модели банковских терминалов и запросить активацию">
<bpmn:incoming>F_st_connect_tm_req</bpmn:incoming>
<bpmn:outgoing>F_tm_req_tm_wait</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="tm_wait" name="Конфигурация и драйверы HAL получены">
<bpmn:incoming>F_tm_req_tm_wait</bpmn:incoming>
<bpmn:outgoing>F_tm_wait_tm_test</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_tm_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:task id="tm_test" name="Тестовая оплата картой через HAL">
<bpmn:incoming>F_tm_wait_tm_test</bpmn:incoming>
<bpmn:outgoing>F_tm_test_st_join</bpmn:outgoing>
</bpmn:task>
<bpmn:sequenceFlow id="F_st_start_st_dump" sourceRef="st_start" targetRef="st_dump" />
<bpmn:sequenceFlow id="F_st_dump_st_kit" sourceRef="st_dump" targetRef="st_kit" />
<bpmn:sequenceFlow id="F_st_kit_st_split" sourceRef="st_kit" targetRef="st_split" />
<bpmn:sequenceFlow id="F_st_split_st_prep" sourceRef="st_split" targetRef="st_prep" />
<bpmn:sequenceFlow id="F_st_split_st_connect" sourceRef="st_split" targetRef="st_connect" />
<bpmn:sequenceFlow id="F_st_prep_st_scan" sourceRef="st_prep" targetRef="st_scan" />
<bpmn:sequenceFlow id="F_st_scan_st_send" sourceRef="st_scan" targetRef="st_send" />
<bpmn:sequenceFlow id="F_st_send_st_join" sourceRef="st_send" targetRef="st_join" />
<bpmn:sequenceFlow id="F_st_connect_tm_req" sourceRef="st_connect" targetRef="tm_req" />
<bpmn:sequenceFlow id="F_tm_req_tm_wait" sourceRef="tm_req" targetRef="tm_wait" />
<bpmn:sequenceFlow id="F_tm_wait_tm_test" sourceRef="tm_wait" targetRef="tm_test" />
<bpmn:sequenceFlow id="F_tm_test_st_join" sourceRef="tm_test" targetRef="st_join" />
<bpmn:sequenceFlow id="F_st_join_st_wait" sourceRef="st_join" targetRef="st_wait" />
<bpmn:sequenceFlow id="F_st_wait_st_merge" sourceRef="st_wait" targetRef="st_merge" />
<bpmn:sequenceFlow id="F_st_merge_st_pilot" sourceRef="st_merge" targetRef="st_pilot" />
<bpmn:sequenceFlow id="F_st_pilot_st_gw" sourceRef="st_pilot" targetRef="st_gw" />
<bpmn:sequenceFlow id="F_st_gw_st_open" name="Нет" sourceRef="st_gw" targetRef="st_open" />
<bpmn:sequenceFlow id="F_st_gw_st_fix" name="Да" sourceRef="st_gw" targetRef="st_fix" />
<bpmn:sequenceFlow id="F_st_fix_st_merge" sourceRef="st_fix" targetRef="st_merge" />
<bpmn:sequenceFlow id="F_st_open_st_end" sourceRef="st_open" targetRef="st_end" />
<bpmn:textAnnotation id="A_dump"><bpmn:text>Выгрузка — штатная функция старой кассы. Сотрудник делает её по инструкции, при необходимости с удалённой поддержкой. Выезд инженера не нужен.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A_dump" sourceRef="st_dump" targetRef="A_dump" />
<bpmn:textAnnotation id="A_scan"><bpmn:text>Инвентаризация при приёме магазина проводится в любом случае: она даёт фактические остатки. Сопоставление номенклатуры от неё не зависит и начинается раньше, по выгрузке. Короб в заводской упаковке — скан штрихкода короба.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A_scan" sourceRef="st_scan" targetRef="A_scan" />
</bpmn:process>
<bpmn:process id="Proc_CL" isExecutable="false">
