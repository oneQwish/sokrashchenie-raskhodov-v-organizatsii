<bpmn:flowNodeRef>cl_gw1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cl_ai_send</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cl_ai_wait</bpmn:flowNodeRef>
