<bpmn:outgoing>F_cl_dev_wait_cl_dev_act</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_cl_dev_wait" />
</bpmn:intermediateCatchEvent>
<bpmn:task id="cl_dev_act" name="Активировать устройства, назначить драйверы HAL">
<bpmn:incoming>F_cl_dev_wait_cl_dev_act</bpmn:incoming>
<bpmn:outgoing>F_cl_dev_act_cl_dev_send</bpmn:outgoing>
</bpmn:task>
<bpmn:intermediateThrowEvent id="cl_dev_send" name="Конфигурация отправлена">
<bpmn:incoming>F_cl_dev_act_cl_dev_send</bpmn:incoming>
<bpmn:outgoing>F_cl_dev_send_cl_join_f</bpmn:outgoing>
<bpmn:messageEventDefinition id="MED_cl_dev_send" />
</bpmn:intermediateThrowEvent>
<bpmn:startEvent id="cl_start" name="Карточка магазина получена">
